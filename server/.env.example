PORT=5000
MONGO_URI=mongodb://username:password@cluster.mongodb.net:27017/crm_db
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret

# Hostinger SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@spmdashboard.cloud
SMTP_PASS=your_mailbox_password_here
OTP_FROM_EMAIL="Samarth Pest Management <info@spmdashboard.cloud>"
OTP_EXPIRY_MINUTES=5

# Security & Admin Access Configuration
ADMIN_SECRET_PATH=your_secret_admin_route_segment
ADMIN_BOOTSTRAP_SECRET=your_secret_admin_bootstrap_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=12h
MAX_SESSION_HOURS=12
ADMIN_REGISTRATION_ENABLED=true
